# Copy this file to `.env.local` only if the backend isn't running at the
# default http://127.0.0.1:8000 (see frontend/lib/api.ts). Not needed for a
# normal local setup with both services on their default ports.

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Production (set in Vercel's Environment Variables, not here):
# NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
